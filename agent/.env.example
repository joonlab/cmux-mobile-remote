# 에이전트 설정 예시 — 맥마다 값이 다릅니다. pm2 로 띄울 때 셸에서 export 하거나
#   set -a; . agent/.env; set +a; pm2 start agent/ecosystem.config.js --update-env
# 처럼 읽어 들이세요. 실제 값이 든 agent/.env 는 git 에 올라가지 않습니다.

# 이 맥의 이름표 — 폰 앱 cmr.machines 의 key 와 같게(laptop · home 권장)
CMR_MACHINE=laptop

# 쓰기 모드: off(기본, 읽기 전용) · allowlist(CMR_SEND_ALLOW 의 surface UUID 와 이 에이전트가 만든 워크스페이스만) · on
CMR_SEND=off
CMR_SEND_ALLOW=

# 상대 맥 에이전트 주소(이어가기 때 «그 세션이 저쪽에서 돌고 있나»를 묻는다). 맥 한 대면 비워 두세요.
CMR_PEER_URL=
CMR_PEER_NAME=홈맥

# 화면 적립(스크롤백 대신 화면을 찍어 밀려난 줄을 쌓기): on · off
CMR_SCREENLOG=on

# 선택: 데이터 폴더(감사 로그·화면 적립·스니펫). 기본은 agent/data
# CMR_DATA=
# 선택: Claude Code 설정 폴더(기본 ~/.claude)
# CMR_CLAUDE_DIR=
